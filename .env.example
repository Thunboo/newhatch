CAPTURE_INTERFACE=eth0
FLAG_REGEX=FLAG\{[^}\r\n]+\}
SEGMENT_DURATION=30m
SEGMENT_RETENTION_COUNT=3
FLOW_IDLE_TIMEOUT=30s
MAX_STREAM_BYTES=4MiB
RUST_LOG=newhatch=info
FRONTEND_PORT=8080

# Keep "local" for the all-in-one deployment. Use "receiver" on a remote analyzer.
PACKET_INGRESS_MODE=local
COLLECTOR_LISTEN_ADDR=0.0.0.0:39090
# Required in receiver mode. Exact comma-separated source IPs of manifested collectors.
COLLECTOR_ALLOWED_IPS=

# Collector-side settings (used by the collector Compose profile).
COLLECTOR_ID=vulnbox-1
RECEIVER_ADDR=127.0.0.1
RECEIVER_PORT=39090
COLLECTOR_QUEUE_CAPACITY=8192

# Required. Generate a hash using the hash-password CLI; keep single quotes for Compose.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=''
AUTH_SESSION_TTL_SECONDS=86400
# Empty permits only loopback. Example: 192.168.1.0/24,fd42:1234::/64
AUTH_ALLOWED_SUBNETS=
# Set true when serving through HTTPS. Use HTTP only on a trusted isolated network.
AUTH_COOKIE_SECURE=false

# Keep this aligned with enabled sources until Suricata live filter reload lands.
SURICATA_BPF_FILTER=tcp and (port 8080)
