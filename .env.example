CAPTURE_INTERFACE=eth0
FLAG_REGEX=FLAG\{[^}\r\n]+\}
SEGMENT_DURATION=30m
SEGMENT_RETENTION_COUNT=3
FLOW_IDLE_TIMEOUT=15s
MAX_STREAM_BYTES=16MiB
RUST_LOG=newhatch=info
FRONTEND_PORT=8080

#--------------#
# Analyzer mode:
# - "local"  captures traffic on this host
# - "remote" receives collector traffic
ANALYZER=local

#--------------------------#
#   For REMOTE mode only   #
# --- Analyzer settings ---#
# Analyzer listen address; accepts IP:port or FQDN:port.
LISTEN_CONNSTR=0.0.0.0:39090
# Optional comma-separated collector IPs or FQDNs. Empty accepts any host.
ALLOWED_COLLECTORS=

# -- Collector settings -- #
COLLECTOR_ID=vulnbox-1
ANALYZER_CONNSTR=127.0.0.1:39090
# Maximum classified packets buffered before new packets are dropped.
QUEUE_CAPACITY=8192
#--------------------------#


# Required login credentials. SESSION_EXPIRACY supports s, m, h and d.
NEWHATCH_USERNAME=admin
NEWHATCH_PASSWORD=admin123
SESSION_EXPIRACY=86400s
# Loopback is always permitted.
# Additional team subnets: 192.168.1.0/24,fd42:1234::/64
# Individual IPv4 addresses use /32: AUTH_ALLOWED_SUBNETS=10.10.10.5/32,10.10.10.7/32
# Individual IPv6 addresses use /128, for example fd42::5/128.
AUTH_ALLOWED_SUBNETS=
# Set true when serving through HTTPS. Use HTTP only on a trusted isolated network.
AUTH_COOKIE_SECURE=false

# Keep this aligned with enabled sources until Suricata live filter reload lands.
SURICATA_BPF_FILTER=tcp and (port 8080)
